---

{% set slugSuffix = '' %}
<div class="row">
  <div class="col-md-10">
    <h3 class="category-title">content | become a Sigma</h3><hr>

    {% for post in pagePosts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}

    {% include "partials/pagination.njk" %}
  </div>

  {% include "partials/sidebar.njk" %}
</div>
