---
layout: layouts/base.njk
title: Archive
permalink: /archive/
---

<section class="simple-page">
  <h1 class="post-title">Archive</h1>
  <p class="post-summary">按年份列出全部 published 文章。</p>

  {% for year, posts in collections.publishedPosts | groupByYear %}
  <section class="archive-year">
    <h2 class="section-title">{{ year }}</h2>
    <ul class="rail-links archive-links">
      {% for post in posts %}
      <li>
        <a href="{{ post.url }}">
          <time class="archive-date">{{ post.data.date | dateDisplay }}</time>
          <span>{{ post.data.title }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</section>
