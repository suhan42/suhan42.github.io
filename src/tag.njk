---
pagination:
  data: collections.allTags
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
layout: layouts/base.njk
eleventyComputed:
  title: "Tag: {{ tag }}"
---

<section class="simple-page">
  <h1 class="post-title">#{{ tag }}</h1>
  <p class="post-summary">Tag archive</p>
  <div class="post-list">
    {% for post in collections.publishedPosts %}
    {% if post.data.tags and tag in post.data.tags %}
      {% include "partials/post-card.njk" %}
    {% endif %}
    {% endfor %}
  </div>
</section>
