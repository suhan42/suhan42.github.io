{# 文章卡片：cover 可显式覆盖封面，否则自动取正文第一张真实图片；没有图片时只渲染纯文字卡。 #}
{% set bodyImage = post.templateContent | firstImage %}
{% set cardImage = post.data.cover or bodyImage %}
<article class="post-card{% if not cardImage %} no-cover{% endif %}" data-category="{{ post.data.category }}">
  {% if cardImage %}
  <div class="post-media" data-category="{{ post.data.category }}" aria-hidden="true">
    <img src="{{ cardImage }}" alt="" class="post-cover" loading="lazy" decoding="async">
  </div>
  {% endif %}

  <div class="post-body-area">
    <div class="post-meta">
      <a href="/categories/{{ post.data.category }}/" class="post-category">{{ post.data.category }}</a>
      <time datetime="{{ post.data.date | dateToIso }}">{{ post.data.date | dateDisplay }}</time>
    </div>

    <a href="{{ post.url }}" class="card-link">
      <h3 class="post-title">{{ post.data.title }}</h3>
    </a>

    {% set cardSummary = post.data.summary or post.templateContent | excerpt %}
    {% if cardSummary %}
    <p class="post-summary">{{ cardSummary }}</p>
    {% endif %}
  </div>
</article>
