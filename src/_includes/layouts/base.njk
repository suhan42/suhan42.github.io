<!DOCTYPE html>
<html lang="{{ site.language or 'zh-CN' }}" data-theme="night">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0b0d14">
  <meta name="description" content="{{ description or 'suhan 的个人博客，收录技术笔记、随笔和交互作品。' }}">
  <title>{% if title and title != site.title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>

  <script type="application/json" id="theme-config">{{ themes | dump | safe }}</script>
  <script>
    // 在首帧前恢复主题，避免刷新时闪白或闪黑；没有保存值时跟随系统偏好。
    (() => {
      let stored = null;
      try {
        stored = localStorage.getItem("site-theme");
      } catch (error) {
        stored = null;
      }
      const themeConfigElement = document.getElementById("theme-config");
      const themeConfig = themeConfigElement ? JSON.parse(themeConfigElement.textContent) : [];
      const systemScheme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      const defaultTheme = themeConfig.find(item => item.scheme === systemScheme && item.default)?.id || themeConfig[0]?.id || "night";
      const theme = themeConfig.some(item => item.id === stored) ? stored : defaultTheme;
      document.documentElement.dataset.theme = theme;
      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.content = themeConfig.find(item => item.id === theme)?.color || "#0b0d14";
    })();
  </script>

  <link href="/assets/images/suhan.png" rel="icon">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/css/themes.css" rel="stylesheet">
  <link href="/assets/css/main.css" rel="stylesheet">
  <link href="/assets/css/markdown.css" rel="stylesheet">
  <link href="/assets/vendor/katex/katex.min.css" rel="stylesheet">
  {% if pageStyles %}
  <style>{{ pageStyles | safe }}</style>
  {% endif %}
</head>
<body>
  <a class="visually-hidden" href="#main">跳到主要内容</a>
  {% include "partials/site-header.njk" %}

  <main id="main" class="layout{% if postLayout %} post-layout-shell{% endif %}" tabindex="-1">
{% if showRail %}
    <div class="content-rail">
      <div class="content-main">
{{ content | trim | safe }}
      </div>
      {% include "partials/sidebar.njk" %}
    </div>
{% else %}
{{ content | trim | safe }}
{% endif %}
  </main>

  {% include "partials/site-footer.njk" %}

  <script src="/assets/js/theme.js"></script>
  <script src="/assets/js/site.js"></script>
</body>
</html>
