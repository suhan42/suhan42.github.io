{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@shikijs/transformers": "4.6.0",
    "katex": "0.19.1",
    "markdown-it": "^14.3.3",
    "playwright": "^1.65.0",
    "shiki": "4.6.0"
  },
  "scripts": {
    "validate:content": "node scripts/validate-content.mjs",
    "validate:output": "node scripts/validate-output.mjs",
    "assets:migrate": "node scripts/migrate-post-assets.mjs",
    "assets:sync": "node scripts/migrate-post-assets.mjs --all",
    "test:first-image": "node scripts/test-first-image.mjs",
    "test:post-assets": "node scripts/test-post-assets.mjs",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:theme": "node scripts/test-theme-config.mjs",
    "fonts:prune": "node scripts/prune-katex-fonts.mjs",
    "publish:pages:check": "node scripts/publish-pages.mjs --check",
    "publish:pages": "node scripts/publish-pages.mjs",
    "clean": "node scripts/clean-site.mjs",
    "prebuild": "node scripts/migrate-post-assets.mjs --all --write",
    "preserve": "node scripts/migrate-post-assets.mjs --all --write",
    "build": "npm run clean && npx @11ty/eleventy && node scripts/generate-redirects.mjs",
    "serve": "npx @11ty/eleventy --serve"
  }
}
